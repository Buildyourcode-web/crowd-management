# ─── Copy this file to .env and fill in values ────────────────────────────────

# ─── Application ──────────────────────────────────────────────────────────────
APP_NAME=Temple AI Crowd Management System
APP_VERSION=1.0.0
APP_DESCRIPTION=Enterprise AI-powered crowd management for temple festivals
DEBUG=false
ENVIRONMENT=development
API_V1_PREFIX=/api/v1

# ─── Security ─────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-super-secret-key-here-min-32-characters
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256

# ─── Supabase / PostgreSQL Database ──────────────────────────────────────────
# Paste your Supabase PostgreSQL connection string below:
# Format: postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
SUPABASE_DATABASE_URL=postgresql://postgres:your_password@db.your_project_ref.supabase.co:5432/postgres

# Fallback PostgreSQL credentials (if SUPABASE_DATABASE_URL is empty):
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password
POSTGRES_POOL_SIZE=20
POSTGRES_MAX_OVERFLOW=40
POSTGRES_POOL_RECYCLE=3600
POSTGRES_POOL_TIMEOUT=30

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_MAX_CONNECTIONS=50
REDIS_SOCKET_TIMEOUT=5
REDIS_SOCKET_CONNECT_TIMEOUT=5

# ─── CORS (comma-separated for multiple origins) ──────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
ALLOWED_METHODS=*
ALLOWED_HEADERS=*
ALLOW_CREDENTIALS=true

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_DIR=logs
LOG_ROTATION=100 MB
LOG_RETENTION=30 days

# ─── WebSocket ────────────────────────────────────────────────────────────────
WS_HEARTBEAT_INTERVAL=30

# ─── System Defaults ──────────────────────────────────────────────────────────
MAX_CAMERAS=200
DEFAULT_FPS=15
DEFAULT_CONFIDENCE=0.5
DEFAULT_IOU=0.45
DEFAULT_DETECTION_FPS=5
DEFAULT_SNAPSHOT_INTERVAL=30
DEFAULT_ALERT_INTERVAL=300

# ─── pgAdmin (docker-compose --profile dev) ───────────────────────────────────
PGADMIN_EMAIL=admin@temple.local
PGADMIN_PASSWORD=admin
